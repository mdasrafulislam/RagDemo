<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped to nuget.org. The machine-level config also lists a private Azure DevOps
     feed (Unified-Feed) which returns 401 Unauthorized and aborts restore; <clear/>
     keeps this project buildable. If your org requires that feed, authenticate to it
     and add it back here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
